# Copy to .env and replace every secret. Use URL-safe random values, for example:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

TELEGRAM_BOT_TOKEN=123456789:replace-with-token-from-BotFather
ADMIN_TELEGRAM_IDS=123456789
BOT_API_TOKEN=replace-with-a-random-secret-of-at-least-32-chars

SITE_ADDRESS=:80
HTTP_PORT=8080
HTTPS_PORT=8443
PUBLIC_HOST=localhost:8080
PUBLIC_HTTPS=false
WEBAPP_URL=http://localhost:8080
# Empty: long polling with a single bot replica. Set to the public https origin to use webhooks.
WEBHOOK_BASE_URL=
# Required with WEBHOOK_BASE_URL: 32-256 characters of A-Z, a-z, 0-9, _ or -.
WEBHOOK_SECRET=

POSTGRES_DB=catalog

MIGRATION_DB_USER=catalog_owner
MIGRATION_DB_PASSWORD=replace-with-migration-password

DB_USER=catalog_app
DB_PASSWORD=replace-with-app-password

MINIO_ROOT_USER=minio-root
MINIO_ROOT_PASSWORD=replace-with-minio-root-password
MINIO_BUCKET=product-images
MINIO_APP_ACCESS_KEY=catalog-app
MINIO_APP_SECRET_KEY=replace-with-minio-app-secret

ENVIRONMENT=production
LOG_LEVEL=INFO
DEV_AUTH_ENABLED=false
DEV_AUTH_TELEGRAM_ID=
