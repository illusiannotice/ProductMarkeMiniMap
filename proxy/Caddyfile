{
	admin off
}

{$SITE_ADDRESS::80} {
	handle /api/* {
		request_body {
			max_size 6MB
		}
		reverse_proxy {
			dynamic a api 8000 {
				refresh 5s
			}
			lb_policy round_robin
			lb_try_duration 5s
		}
	}

	handle /telegram/* {
		request_body {
			max_size 1MB
		}
		reverse_proxy {
			dynamic a bot 8081 {
				refresh 5s
			}
			lb_try_duration 5s
		}
	}

	# Presigned image URLs are signed for this host; Caddy keeps the Host header,
	# so MinIO can verify the signature. Only reads are exposed.
	handle /{$MINIO_BUCKET:product-images}/* {
		@read method GET HEAD
		handle @read {
			reverse_proxy minio:9000
		}
		respond 405
	}

	handle {
		reverse_proxy {
			dynamic a web 3000 {
				refresh 5s
			}
			lb_policy round_robin
			lb_try_duration 5s
		}
	}
}
